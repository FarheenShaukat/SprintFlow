{
  "version": 2,
  "regions": ["sin1"],
  "env": {
    "NEXT_PUBLIC_API_URL": "/api",
    "FRONTEND_URL": "https://sprint-flow-five.vercel.app",
    "MCP_PUBLIC_URL": "https://sprint-flow-five.vercel.app"
  },
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "backend/api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/mcp/?",
      "dest": "/backend/api/index.py"
    },
    {
      "src": "/(oauth/.*|\\.well-known/.*)",
      "dest": "/backend/api/index.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/index.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/backend/api/index.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
